# Frontend (Vite) - copy to frontend/.env. No secrets here: VITE_* values are bundled into the browser.
# Leave empty to use the Vite proxy (/api -> localhost:8000, see vite.config.ts)
VITE_API_BASE=
# true = always use the radar/simulator mock JSON instead of calling the backend
VITE_USE_MOCK=false
VITE_ADAPTY_APP_ID=6a2a9879-18a9-41ff-9adc-622ce922a1bf
